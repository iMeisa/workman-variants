default partial alphanumeric_keys
xkb_symbols "arkman" {

    name[Group1]= "Arabic (Workman)";

    key <TLDE> {[           grave,                tilde,                      any,     any ]};  // ` ~
    key <AE01> {[               1,               exclam,                 Arabic_1,     any ]};  // 1 !     ١
    key <AE02> {[               2,                   at,                 Arabic_2,     any ]};  // 2 @     ٢
    key <AE03> {[               3,           numbersign,                 Arabic_3,     any ]};  // 3 #     ٣
    key <AE04> {[               4,               dollar,                 Arabic_4,     any ]};  // 4 $     ٤
    key <AE05> {[               5,              percent,                 Arabic_5,     any ]};  // 5 %     ٥
    key <AE06> {[               6,          asciicircum,                 Arabic_6,     any ]};  // 6 ^     ٦
    key <AE07> {[               7,            ampersand,                 Arabic_7,     any ]};  // 7 &     ٧
    key <AE08> {[               8,             asterisk,                 Arabic_8,     any ]};  // 8 *     ٨
    key <AE09> {[               9,           parenright,                 Arabic_9,     any ]};  // 9 )     ٩
    key <AE10> {[               0,            parenleft,                 Arabic_0,     any ]};  // 0 (      ٠
    key <AE11> {[           minus,           underscore,            Arabic_shadda,     any ]};  // - _     ‎ّ◌
    key <AE12> {[           equal,                 plus,                      any,     any ]};  // = +     ≠ ≈

    key <AD01> {[      Arabic_qaf,           Arabic_qaf,                      any,     any ]};  // ‎ق‎
    key <AD02> {[      Arabic_dal,          Arabic_thal,                      any,     any ]};  // ‎د
    key <AD03> {[       Arabic_ra,            Arabic_ra,                      any,     any ]};  // ‎ر‎
    key <AD04> {[      Arabic_waw,    Arabic_hamzaonwaw,             Arabic_damma,     any ]};  // ‎و‎ ؤ     ‎‎ُ◌
    key <AD05> {[      Arabic_beh,           Arabic_beh,                      any,     any ]};  // ‎ب‎
    key <AD06> {[     Arabic_jeem,          Arabic_jeem,                      any,     any ]};  // ‎ج
    key <AD07> {[      Arabic_feh,           Arabic_feh,                      any,     any ]};  // ‎ف‎
    key <AD08> {[    Arabic_ghain,         Arabic_ghain,                      any,     any ]};  // ‎غ‎
    key <AD09> {[      Arabic_tah,           Arabic_tah,                      any,     any ]};  // ‎ط‎
    key <AD10> {[Arabic_semicolon,                colon,                semicolon,     any ]};  // ؛ :     ;
    key <AD11> {[    bracketright,           braceright,                      any,     any ]};  // ‎] }‎
    key <AD12> {[     bracketleft,            braceleft,                      any,     any ]};  // ‎[ {‎

    key <AC01> {[      Arabic_ain,           Arabic_ain,             Arabic_fatha,     any ]};  // ‎ع‎       ◌َ
    key <AC02> {[     Arabic_seen,         Arabic_sheen,                      any,     any ]};  // ‎س‎
    key <AC03> {[       Arabic_ha,            Arabic_ha,                      any,     any ]};  // ‎ه
    key <AC04> {[      Arabic_teh,          Arabic_theh,                      any,     any ]};  // ‎ت‎ ‎ث
    key <AC05> {[      Arabic_hah,           Arabic_hah,                      any,     any ]};  // ‎ح
    key <AC06> {[Arabic_tehmarbuta,   Arabic_tehmarbuta,                      any,     any ]};  // ‎ة‎
    key <AC07> {[     Arabic_noon,          Arabic_noon,                      any,     any ]};  // ‎ن
    key <AC08> {[     Arabic_alef,   Arabic_hamzaonalef,    Arabic_hamzaunderalef, Arabic_maddaonalef ]};  // ‎ا‎ ‎أ
    key <AC09> {[Arabic_alefmaksura,  Arabic_hamzaonyeh,  Arabic_superscript_alef,     any ]};  // ‎ى‎ ‎ٰئ‎     ‎◌ٰ‎
    key <AC10> {[      Arabic_yeh,           Arabic_yeh,             Arabic_kasra,     any ]};  // ‎ي‎       ‎◌ِ‎
    key <AC11> {[    Arabic_hamza,             quotedbl,               apostrophe,     any ]};  // ‎ء‎ "     '
    key <BKSL> {[       backslash,                  bar,                      any,     any ]};  // \ |

    key <AB01> {[     Arabic_zain,           Arabic_zah,                      any,     any ]};  // ‎ز‎ ظ
    key <AB02> {[     Arabic_khah,          Arabic_khah,                      any,     any ]};  // ‎خ‎
    key <AB03> {[     Arabic_meem,          Arabic_meem,                      any,     any ]};  // ‎م‎
    key <AB04> {[      Arabic_sad,           Arabic_sad,                      any,     any ]};  // ‎ص‎
    key <AB05> {[      Arabic_dad,           Arabic_dad,                      any,     any ]};  // ‎ض
    key <AB06> {[      Arabic_kaf,           Arabic_kaf,                      any,     any ]};  // ‎ك‎
    key <AB07> {[      Arabic_lam,                UFEFB,                      any,     any ]};  // ‎ل‎ ‎ﻻ
    key <AB08> {[    Arabic_comma,                 less,                    comma,     any ]};  // ‎،‎ <     ,
    key <AB09> {[          period,              greater,             Arabic_sukun,     any ]};  // ‎. >     ◌ْ
    key <AB10> {[           slash, Arabic_question_mark,                      any,     any ]};  // ‎/‎ ‎؟‎

    include "level3(ralt_switch)"
};
